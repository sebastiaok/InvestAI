# Azure OpenAI / OpenAI settings
AOAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AOAI_API_KEY=your_api_key_here
AOAI_DEPLOY_GPT4O_MINI=gpt-4o-mini
AOAI_API_VERSION=2024-02-15-preview

# App environment
APP_ENV=local

# 선택: MCP Tool 연동 시 (app/tools/mcp_tools.py 에서 로더 구현 후) 1 로 설정
# MCP_TOOLS_ENABLED=0
